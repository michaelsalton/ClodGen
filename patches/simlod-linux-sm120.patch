@@ -79,12 +79,23 @@ struct CudaModule{
 		// 	println("{} does not exists", path);
 		// }
 
-		string cuda_path = std::getenv("CUDA_PATH");
+		// CUDA_PATH is not conventionally set on Linux; fall back to the
+		// default toolkit location instead of constructing a string from null.
+		const char* cuda_path_env = std::getenv("CUDA_PATH");
+		string cuda_path = cuda_path_env ? cuda_path_env : "/usr/local/cuda";
 		// string cuda_include = "-I " + cuda_path + "/include";
 
+		// Target arch is overridable; default matches Blackwell (sm_120).
+		const char* arch_env = std::getenv("SIMLOD_GPU_ARCH");
+		string arch_opt = std::format("--gpu-architecture={}",
+			arch_env ? arch_env : "compute_120");
+
 		string optInclude = std::format("-I {}", dir).c_str();
 		string cuda_include = std::format("-I {}/include", cuda_path);
-		// string cudastd_include = std::format("-I {}/include/cuda/std", cuda_path);
+		// CUDA 13 moved the CCCL/libcu++ headers (<cuda/std/*>, pulled in by
+		// cooperative_groups) into include/cccl. Harmless on CUDA 12, where
+		// they sit directly under include/.
+		string cccl_include = std::format("-I {}/include/cccl", cuda_path);
 
 		println("cuda_include: '{}'", optInclude);
 
