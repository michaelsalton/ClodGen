diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..717b685
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,110 @@
+cmake_minimum_required(VERSION 3.22)
+project(CudaLOD)
+
+include(FetchContent)
+
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+# Linux/CMake port of build/CudaLOD.vcxproj. The source list below mirrors the
+# vcxproj's ClCompile entries; CUDA is compiled at runtime via NVRTC
+# (CudaModularProgram.h), so there are no .cu files in this target.
+
+add_executable(${PROJECT_NAME}
+	src/main.cpp
+	src/Framebuffer.cpp
+	src/GLTimerQueries.cpp
+	src/OpenVRHelper.cpp
+	src/OrbitControls.cpp
+	src/Renderer.cpp
+	src/Texture.cpp
+	include/unsuck_platform_specific.cpp
+	modules/compute/ComputeLasLoader.cpp
+	modules/compute/LasLoaderSparse.cpp
+	libs/glew/glew.c
+	libs/imgui/imgui.cpp
+	libs/imgui/imgui_demo.cpp
+	libs/imgui/imgui_draw.cpp
+	libs/imgui/imgui_tables.cpp
+	libs/imgui/imgui_widgets.cpp
+	libs/imgui/backends/imgui_impl_glfw.cpp
+	libs/imgui/backends/imgui_impl_opengl3.cpp
+	libs/implot/implot.cpp
+	libs/implot/implot_demo.cpp
+	libs/implot/implot_items.cpp
+	libs/toojpeg/toojpeg.cpp
+	# Stands in for the Windows-only openvr_api; see the file's header comment.
+	cmake/openvr_stub.cpp)
+
+if (CMAKE_BUILD_TYPE STREQUAL "Debug")
+	target_compile_options(${PROJECT_NAME} PRIVATE -O0 -g)
+else ()
+	target_compile_options(${PROJECT_NAME} PRIVATE -O3)
+endif ()
+
+# Upstream is MSVC-only and warns heavily under gcc; silence the noise so real
+# problems stay visible.
+target_compile_options(${PROJECT_NAME} PRIVATE -w)
+
+# The device slab size is a compile-time #define in
+# sampling_cuda_nonprogressive.h. A bare `cmake -DCUDALOD_MAX_BUFFER_SIZE=...`
+# only sets a cache variable, so it must be forwarded as a real compile
+# definition here or the override silently does nothing. Leave empty to use the
+# header's own default (8GB, sized for a 16GB card -- see the comment there).
+set(CUDALOD_MAX_BUFFER_SIZE "" CACHE STRING "Bytes for the CudaLOD device slab")
+if(CUDALOD_MAX_BUFFER_SIZE)
+	target_compile_definitions(${PROJECT_NAME} PRIVATE
+		CUDALOD_MAX_BUFFER_SIZE=${CUDALOD_MAX_BUFFER_SIZE})
+endif()
+
+target_include_directories(${PROJECT_NAME} PRIVATE
+	include
+	modules
+	libs/glew/include
+	libs/glm
+	libs/imgui
+	libs/imgui/backends
+	libs/implot
+	libs/json
+	libs/laszip
+	libs/openvr/headers
+	libs/toojpeg)
+
+# Dependencies
+
+## CUDA toolkit. Uses the driver API + NVRTC for runtime kernel compilation.
+find_package(CUDAToolkit 11.8 REQUIRED)
+# CUDA 13 relocated thrust/cub/libcu++ into include/cccl. Harmless on CUDA 12,
+# where they sit directly under include/.
+target_include_directories(${PROJECT_NAME} PRIVATE
+	${CUDAToolkit_INCLUDE_DIRS}
+	${CUDAToolkit_INCLUDE_DIRS}/cccl)
+target_link_libraries(${PROJECT_NAME}
+	CUDA::cuda_driver
+	CUDA::cudart
+	CUDA::nvrtc)
+
+## OpenGL
+find_package(OpenGL REQUIRED)
+target_link_libraries(${PROJECT_NAME} ${OPENGL_LIBRARY})
+
+## GLFW (fetched; the vendored lib is Windows-only)
+include(cmake/glfw.cmake)
+target_include_directories(${PROJECT_NAME} PRIVATE ${glfw_SOURCE_DIR}/include)
+target_link_libraries(${PROJECT_NAME} glfw)
+
+## laszip
+add_subdirectory(libs/laszip)
+target_link_libraries(${PROJECT_NAME} laszip)
+
+# CudaLOD resolves ./modules and ./shaders relative to the working directory.
+# Symlink rather than copy: the .cu kernels are compiled at runtime by NVRTC and
+# are not build inputs, so a POST_BUILD copy goes stale whenever a kernel is
+# edited without the binary relinking.
+foreach(dir modules shaders)
+	if (NOT EXISTS "${CMAKE_CURRENT_BINARY_DIR}/${dir}")
+		execute_process(COMMAND ${CMAKE_COMMAND} -E create_symlink
+			"${PROJECT_SOURCE_DIR}/${dir}"
+			"${CMAKE_CURRENT_BINARY_DIR}/${dir}")
+	endif ()
+endforeach()
