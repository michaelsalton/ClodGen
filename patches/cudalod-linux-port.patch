+		GIT_REPOSITORY      https://github.com/glfw/glfw.git
+		GIT_TAG             3.3.2
+)
+
+FetchContent_MakeAvailable(glfw)
diff --git a/cmake/openvr_stub.cpp b/cmake/openvr_stub.cpp
new file mode 100644
index 0000000..f826aee
--- /dev/null
+++ b/cmake/openvr_stub.cpp
@@ -0,0 +1,45 @@
+// Minimal no-op OpenVR implementation for Linux builds.
+//
+// CudaLOD vendors only a Windows openvr_api.lib / .dll, so there is nothing to
+// link against here. VR is entirely gated behind Renderer::vrEnabled (off by
+// default), so the VR code paths never execute -- these definitions exist only
+// to satisfy the linker. Everything reports "no HMD", which is the truth.
+//
+// If you ever want working VR, drop a real linux64 libopenvr_api.so in and
+// remove this file from the CudaLOD target in CMakeLists.txt.
+
+#include "openvr.h"
+
+namespace vr {
+
+bool VR_CALLTYPE VR_IsHmdPresent() { return false; }
+
+bool VR_CALLTYPE VR_IsRuntimeInstalled() { return false; }
+
+const char *VR_CALLTYPE VR_RuntimePath() { return ""; }
+
+const char *VR_CALLTYPE VR_GetVRInitErrorAsSymbol(EVRInitError) {
+	return "VRInitError_Init_HmdNotFound";
+}
+
+const char *VR_CALLTYPE VR_GetVRInitErrorAsEnglishDescription(EVRInitError) {
+	return "OpenVR is not available in this build (no linux64 openvr_api).";
+}
+
+void *VR_CALLTYPE VR_GetGenericInterface(const char *, EVRInitError *peError) {
+	if (peError) *peError = VRInitError_Init_HmdNotFound;
+	return nullptr;
+}
+
+bool VR_CALLTYPE VR_IsInterfaceVersionValid(const char *) { return false; }
+
+uint32_t VR_CALLTYPE VR_GetInitToken() { return 0; }
+
+uint32_t VR_CALLTYPE VR_InitInternal(EVRInitError *peError, EVRApplicationType) {
+	if (peError) *peError = VRInitError_Init_HmdNotFound;
+	return 0;
+}
+
+void VR_CALLTYPE VR_ShutdownInternal() {}
+
+} // namespace vr
